server:
  port: 8080

spring:
  application:
    name: API-GATEWAY

  cloud:
    gateway:
      routes:

        # Customer Service
        - id: customer-service
          uri: lb://CUSTOMER-SERVICE
          predicates:
            - Path=/customers/**

        # Vet Service
        - id: vet-service
          uri: lb://VET-SERVICE
          predicates:
            - Path=/vets/**

        # Visit Service
        - id: visit-service
          uri: lb://VISIT-SERVICE
          predicates:
            - Path=/appointments/**

        # Admin Service
        - id: admin-service
          uri: lb://ADMIN-SERVICE
          predicates:
            - Path=/admin/**

      discovery:
        locator:
          enabled: true
          lower-case-service-id: false

eureka:
  client:
    register-with-eureka: true
    fetch-registry: true

    service-url:
      defaultZone: http://localhost:8761/eureka/

  instance:
    prefer-ip-address: true

management:
  endpoints:
    web:
      exposure:
        include: "*"

logging:
  level:
    org.springframework.cloud.gateway: DEBUG
    reactor.netty: INFO

jwt:
  secret: MyPetClinicSecretKeyMyPetClinicSecretKey123456